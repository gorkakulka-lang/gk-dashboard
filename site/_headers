# Nagłówki bezpieczeństwa i pamięci podręcznej (Netlify).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://fnranvobetqcxtawcjop.supabase.co; worker-src 'self' blob:; media-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/fonts/*
  Cache-Control: public, max-age=2592000

/img/*
  Cache-Control: public, max-age=604800

/ikony/*
  Cache-Control: public, max-age=604800

/vendor/*
  Cache-Control: public, max-age=604800
